SINUO_ENVIRONMENT=development
SINUO_DATABASE_URL=sqlite:///./var/sinuo.db
SINUO_SQLITE_BUSY_TIMEOUT_MS=5000
SINUO_MODEL_ENABLED=false
SINUO_MODEL_NAME=
SINUO_DEEPSEEK_API_KEY=
SINUO_MAX_SPECIALISTS=3
SINUO_MAX_PARALLEL_TASKS=2
SINUO_RUN_TIMEOUT_SECONDS=60
SINUO_PUBLIC_URL=http://127.0.0.1:8000
SINUO_ALLOWED_ORIGINS=http://127.0.0.1:8000
SINUO_SESSION_IDLE_SECONDS=28800
SINUO_SESSION_ABSOLUTE_SECONDS=86400
SINUO_ARGON2_TIME_COST=3
SINUO_ARGON2_MEMORY_KIB=65536
SINUO_ARGON2_PARALLELISM=4
SINUO_ARGON2_HASH_LEN=32
SINUO_ARGON2_SALT_LEN=16
SINUO_LOGIN_RATE_LIMIT_ATTEMPTS=5
SINUO_LOGIN_RATE_LIMIT_WINDOW_SECONDS=300

